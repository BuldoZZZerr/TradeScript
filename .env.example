# Биржа: bingx (по умолчанию), binance, bybit
EXCHANGE=bingx
EXCHANGE_ID=bingx

# Ключи API BingX (создай в настройках: API Management, только Spot)
# Для testnet: https://bingx.com — Demo Trading → API
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Торговая пара
SYMBOL=BTC/USDT

# Сумма в USDT на одну покупку
AMOUNT_QUOTE=50
AMOUNT_USDT=50

# Цель по прибыли в % (продать при росте на столько)
PROFIT_PERCENT=0.5
X=0.5

# Стоп-лосс в % (0 = отключен), только trade_bot.py
STOP_LOSS_PERCENT=0

# Пауза после продажи перед следующей покупкой (сек), только trade_loop.py
WAIT_AFTER_SELL_SEC=300

# Интервалы проверки (сек)
CHECK_INTERVAL_SEC=30
CHECK_ORDER_INTERVAL_SEC=15

# Testnet BingX: true = демо-торговля (open-api-vst.bingx.com)
USE_SANDBOX=true
SANDBOX=true
